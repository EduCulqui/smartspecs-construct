generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Requerimiento {
  id                String   @id @default(cuid())
  creadoEn          DateTime @default(now())

  // Datos del terreno
  anchoTerreno      Float
  largoTerreno      Float
  numeroPisos       Int

  // Preferencias del usuario (guardadas como texto JSON)
  ambientes         String
  preferencias      String

  // Resultados generados por el sistema
  presupuestoMinimo Float?
  presupuestoMaximo Float?
  plantilla3D       String?

  // Estado del flujo
  estado            String   @default("PENDIENTE")
}